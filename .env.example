# =============================================================
# APEXAuto — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================


# -------------------------------------------------------------
# MySQL Database
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Local MySQL (no password):
#   DATABASE_URL=mysql://root@127.0.0.1:3306/car_showroom
#
# Local MySQL (with password):
#   DATABASE_URL=mysql://root:yourpassword@127.0.0.1:3306/car_showroom
#
# Remote (PlanetScale, Railway, etc.):
#   DATABASE_URL=mysql://user:pass@host:3306/car_showroom
# -------------------------------------------------------------

# -------------------------------------------------------------
# Clerk Authentication
# These shared dev keys are already baked into clerk-config.ts
# and work out of the box. Only replace them if you create
# your own Clerk application.
# Get your own keys at: https://dashboard.clerk.com
# -------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZXZvbHZpbmctbXVkZmlzaC00OC5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_lmyTYJHcWmABMJNPsClDqbmoBsqNf3Mfsj3NXrJP8d


# -------------------------------------------------------------
# Admin Access
# Comma-separated list of emails that get /ops-x7k9m2 (admin panel) access.
# Only these Clerk accounts see the Admin nav link and can open the panel.
# Example: ADMIN_EMAIL=you@example.com,partner@example.com
# -------------------------------------------------------------
ADMIN_EMAIL=your-email@example.com


# -------------------------------------------------------------
# Dev Server Port (optional — defaults to 5000)
# -------------------------------------------------------------
PORT=5000


# -------------------------------------------------------------
# Stripe Payments (optional)
# Only needed if you enable payment collection features.
# Get keys from https://dashboard.stripe.com/apikeys
# -------------------------------------------------------------
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
